/*
 * EMAC1 with the AC200 EPHY integrated in some H616 family SoCs. The board
 * has to provide reg_dldo1 (3.3 V) and reg_aldo1 (1.8 V). On boards with
 * CONFIG_SUNXI_H616_INTERNAL_EPHY, U-Boot switches to the AC300 EPHY when
 * the SID reports one, otherwise use the AC300 overlay instead if Ethernet
 * doesn't come up.
 */

&{/aliases} {
	ethernet0 = "/soc/ethernet@5030000";
};

&ac200 {
	ac-ldoin-supply = <&reg_dldo1>;
	ephy-vcc-supply = <&reg_dldo1>;
	rtc-vcc-supply = <&reg_dldo1>;
	tv-vcc-supply = <&reg_aldo1>;
	status = "okay";
};

&ac200_ephy_ctl {
	phy-mode = "rmii";
	x-powers,phy-address = <1>;
	status = "okay";
};

&ac200_pwm_clk {
	status = "okay";
};

&ac300_ephy_package {
	vcc-supply = <&reg_dldo1>;
};

&emac1 {
	pinctrl-names = "default";
	pinctrl-0 = <&rmii_pins>;
	phy-mode = "rmii";
	phy-handle = <&rmii_phy>;
	phy-supply = <&reg_dldo1>;
	allwinner,rx-delay-ps = <3100>;
	allwinner,tx-delay-ps = <700>;
	status = "okay";
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pa_pins>;
	status = "okay";
};

&mdio1 {
	#address-cells = <1>;
	#size-cells = <0>;

	rmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-id0044.1400",
			     "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		clocks = <&ac200_ephy_ctl>;
		resets = <&ac200_ephy_ctl>;
		reset-names = "phy";
	};
};

&pwm {
	status = "okay";
};
